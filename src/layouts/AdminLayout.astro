---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { secondaryButtonClass } from "../components/admin/ui";
import type { Actor } from "../lib/auth/access";
import { listMembershipsByEmail } from "../lib/repo/users";
import type { Center } from "../types/database";

interface Props {
  title: string;
  intro?: string;
  actor: Actor;
  center?: Center;
  active?: 'appearance' | 'items' | 'donations' | 'users' | 'audit' | 'centers';
}

const { title, intro, actor, center, active } = Astro.props;

const successMessages: Record<string, string> = {
  'item-created': 'Artículo creado. Ya aparece en tu web si está visible.',
  'item-saved': 'Artículo guardado.',
  'item-removed': 'Artículo borrado.',
  'image-added': 'Imagen añadida.',
  'image-removed': 'Imagen quitada.',
  'cover-changed': 'Portada cambiada.',
  'donation-added': 'Donación añadida.',
  'donation-voided': 'Donación anulada. Ya no suma en el total.',
  'donation-already-voided': 'Esa donación ya estaba anulada.',
  'user-added': 'Encargada añadida. Ya puede entrar con su cuenta de Google.',
  'user-removed': 'Acceso quitado.',
  'center-created': 'Centro creado.',
};
const ok = Astro.url.searchParams.get('ok');
const okMessage = ok ? (successMessages[ok] ?? 'Cambios guardados.') : null;
const error = Astro.url.searchParams.get('error');

const memberships = actor.isSuperadmin ? [] : await listMembershipsByEmail(actor.email);
const base = center ? `/${center.slug}/admin` : '/admin';
const nav = center
  ? [
      { key: 'appearance', label: 'Apariencia', href: base },
      { key: 'items', label: 'Artículos', href: `${base}/items` },
      { key: 'donations', label: 'Donaciones', href: `${base}/donations` },
      { key: 'users', label: 'Encargadas', href: `${base}/users` },
      { key: 'audit', label: 'Historial', href: `${base}/audit` },
    ]
  : [{ key: 'centers', label: 'Centros', href: '/admin' }];
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/webp" href="/favicon.webp" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} - Panel</title>
  </head>
  <body class="antialiased">
    <header class="border-b border-line bg-white">
      <div class="mx-auto max-w-5xl px-4">
        <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3 py-4">
          <div class="min-w-0">
            {actor.isSuperadmin && center && (
              <a href="/admin" class="mb-1 inline-flex items-center gap-1.5 text-sm font-semibold text-brand hover:underline">
                <Icon name="arrow-left" class="h-4 w-4" />
                Todos los centros
              </a>
            )}
            {!actor.isSuperadmin && memberships.length > 1 && center ? (
              <label class="flex items-center gap-2">
                <span class="sr-only">Cambiar de centro</span>
                <select
                  id="center-switch"
                  class="max-w-full rounded-lg border border-line-strong bg-white py-2 pl-3 pr-8 text-lg font-bold text-ink"
                >
                  {memberships.map((m) => (
                    <option value={`/${m.slug}/admin`} selected={m.slug === center.slug}>{m.name}</option>
                  ))}
                </select>
              </label>
            ) : (
              <p class="truncate text-xl font-bold text-ink">{center ? `Panel de ${center.name}` : 'Administración de la plataforma'}</p>
            )}
          </div>
          <div class="flex items-center gap-3">
            {center && (
              <a href={`/${center.slug}`} target="_blank" rel="noopener noreferrer" class={`${secondaryButtonClass} px-4!`}>
                Ver mi web
                <Icon name="arrow-up-right" class="h-4 w-4" />
                <span class="sr-only">(se abre en una pestaña nueva)</span>
              </a>
            )}
            <details class="relative">
              <summary class="inline-flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-lg px-3 text-base font-semibold text-muted transition-colors hover:bg-surface hover:text-ink">
                <Icon name="sign-out" class="h-4 w-4" />
                Mi cuenta
              </summary>
              <div class="absolute right-0 z-10 mt-1 w-72 space-y-2 rounded-lg border border-line bg-white p-3 shadow-lg">
                <p class="truncate px-1 text-sm text-muted">{actor.email}</p>
                <form method="post" action="/api/auth/logout">
                  <button type="submit" class="min-h-11 w-full rounded-lg px-3 text-left text-base font-semibold text-ink hover:bg-surface">Salir</button>
                </form>
                <form method="post" action="/api/auth/logout-all">
                  <button type="submit" class="min-h-11 w-full rounded-lg px-3 text-left text-base font-semibold text-ink hover:bg-surface">Cerrar sesión en todos los dispositivos</button>
                </form>
              </div>
            </details>
          </div>
        </div>
        {center && (
          <nav aria-label="Secciones del panel" class="-mb-px flex gap-1 overflow-x-auto [mask-image:linear-gradient(to_right,black_88%,transparent)] sm:[mask-image:none]">
            {nav.map((entry) => (
              <a
                href={entry.href}
                aria-current={entry.key === active ? 'page' : undefined}
                class={`inline-flex min-h-12 items-center whitespace-nowrap border-b-2 px-4 text-base font-semibold transition-colors ${
                  entry.key === active
                    ? 'border-brand text-brand'
                    : 'border-transparent text-muted hover:border-line-strong hover:text-ink'
                }`}
              >
                {entry.label}
              </a>
            ))}
          </nav>
        )}
      </div>
    </header>

    <main class="mx-auto max-w-5xl space-y-6 px-4 py-8">
      <div>
        <h1 class="text-2xl font-bold text-ink sm:text-3xl">{title}</h1>
        {intro && <p class="mt-2 max-w-2xl text-base text-muted">{intro}</p>}
      </div>
      {okMessage && (
        <div role="status" data-flash class="flex items-start gap-3 rounded-lg bg-green-50 px-4 py-3 text-base text-green-900 ring-1 ring-green-200">
          <Icon name="check-circle" class="mt-0.5 h-5 w-5 shrink-0" />
          <p class="flex-1">{okMessage}</p>
          <button type="button" data-dismiss class="-m-1 rounded p-1 hover:bg-green-100">
            <span class="sr-only">Cerrar aviso</span>
            <Icon name="x" class="h-5 w-5" />
          </button>
        </div>
      )}
      {error && (
        <div role="alert" class="flex items-start gap-3 rounded-lg bg-red-50 px-4 py-3 text-base text-red-900 ring-1 ring-red-200">
          <Icon name="warning-circle" class="mt-0.5 h-5 w-5 shrink-0" />
          <p class="flex-1">{error}</p>
        </div>
      )}
      <slot />
    </main>

    <script>
      document.querySelectorAll<HTMLElement>('[data-flash]').forEach((flash) => {
        flash.querySelector('[data-dismiss]')?.addEventListener('click', () => flash.remove());
        setTimeout(() => flash.remove(), 8000);
      });
      document.querySelector('nav [aria-current="page"]')?.scrollIntoView({ inline: 'center', block: 'nearest' });
      document.getElementById('center-switch')?.addEventListener('change', (event) => {
        window.location.assign((event.target as HTMLSelectElement).value);
      });
    </script>
  </body>
</html>
