---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { formatDateTime } from "../../lib/format";
import Icon from "../../components/Icon.astro";
import { buttonClass, cardClass, chipClass, formFooterClass, helpClass, inputClass, labelClass, secondaryButtonClass, tableClass, tdClass, thClass } from "../../components/admin/ui";
import { parseNewCenter, parseResolveCapture } from "../../lib/admin/forms";
import { guardSuperadmin } from "../../lib/auth/guard";
import { recordAudit, listAccountAudit } from "../../lib/repo/audit";
import { createCenter, listCenters } from "../../lib/repo/centers";
import { listUnresolvedCaptures, resolveCaptureManually } from "../../lib/repo/pending-captures";

const guard = await guardSuperadmin(Astro);
if (guard instanceof Response) return guard;
const { actor } = guard;

const fail = (message: string) => Astro.redirect(`/admin?error=${encodeURIComponent(message)}`, 303);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();

  if (form.get('intent') === 'resolve_capture') {
    const parsed = parseResolveCapture(form);
    if (!parsed.ok) return fail(parsed.error);
    const resolved = await resolveCaptureManually({ ...parsed.value, actorEmail: actor.email });
    if (!resolved) return fail('Esa orden ya estaba registrada o resuelta. Recarga la página para ver la lista actualizada');
    await recordAudit({
      centerId: resolved.center_id,
      actorEmail: actor.email,
      action: 'payment.resolve',
      entityType: 'pending_capture',
      entityId: parsed.value.orderId,
      summary: `Orden de PayPal ${parsed.value.orderId} (${resolved.amount} €) marcada como resuelta: ${parsed.value.note}`,
    });
    return Astro.redirect('/admin?ok=capture-resolved', 303);
  }

  const parsed = parseNewCenter(form);
  if (!parsed.ok) return fail(parsed.error);
  const created = await createCenter(parsed.value);
  if (!created) return fail('Ya existe un centro con ese identificador');
  await recordAudit({
    centerId: created.id,
    actorEmail: actor.email,
    action: 'center.create',
    entityType: 'center',
    entityId: created.id,
    summary: `Centro creado: ${created.name}`,
  });
  return Astro.redirect(`/admin/centers/${created.slug}?ok=center-created`, 303);
}

const [centers, unresolved, accountAudit] = await Promise.all([listCenters(), listUnresolvedCaptures(), listAccountAudit()]);
const centerNames = new Map(centers.map((center) => [center.id, center.name]));
const host = Astro.url.host;
---

<AdminLayout
  title="Centros"
  intro="Todos los centros de la plataforma. Desde aquí das de alta uno nuevo, ajustas su PayPal o entras en su panel."
  actor={actor}
  active="centers"
>
  {unresolved.length > 0 && (
    <section class={`${cardClass} space-y-3`} data-testid="unresolved-captures" aria-labelledby="unresolved-title">
      <h2 id="unresolved-title" class="text-xl font-bold text-ink">
        {unresolved.length === 1 ? '1 cobro de PayPal sin registrar' : `${unresolved.length} cobros de PayPal sin registrar`}
      </h2>
      <p class="text-base text-muted">La donación de estas órdenes no consta en la web. <strong class="text-ink">No las apuntes a mano sin más:</strong> las «Pendientes de PayPal» se vuelven a comprobar solas cada día y se registran automáticamente en cuanto PayPal confirma el cobro.</p>
      <p class="text-base text-muted">Las que «Requieren revisión» no se registrarán solas: búscalas en PayPal por el número de orden o de cobro. Si decides apuntar la donación a mano, marca antes aquí la orden como resuelta; así el proceso diario no la registrará otra vez y no se contará dos veces.</p>
      <table class={tableClass}>
        <thead>
          <tr>
            <th class={thClass}>Centro</th>
            <th class={thClass}>Artículo</th>
            <th class={thClass}>Importe</th>
            <th class={thClass}>Estado</th>
            <th class={thClass}>PayPal</th>
            <th class={thClass}>Fecha</th>
            <th class={thClass}><span class="sr-only">Acciones</span></th>
          </tr>
        </thead>
        <tbody>
          {unresolved.map((capture) => (
            <tr data-order-id={capture.paypal_order_id}>
              <td class={tdClass} data-label="Centro">{centerNames.get(capture.center_id) ?? capture.center_id}</td>
              <td class={tdClass} data-label="Artículo">{capture.item_name ?? '—'}</td>
              <td class={tdClass} data-label="Importe">{capture.amount} €</td>
              <td class={tdClass} data-label="Estado">
                {capture.status === 'pending'
                  ? <span class={chipClass.info}>Pendiente de PayPal</span>
                  : <span class={chipClass.warn}>Requiere revisión</span>}
                {capture.last_error && <span class="mt-1 block text-sm text-muted">{capture.last_error}</span>}
              </td>
              <td class={`${tdClass} font-mono text-sm`} data-label="PayPal">
                <span class="block">Orden {capture.paypal_order_id}</span>
                {capture.paypal_capture_id && <span class="block">Cobro {capture.paypal_capture_id}</span>}
              </td>
              <td class={tdClass} data-label="Fecha">{formatDateTime(capture.created_at)}</td>
              <td class="py-2 text-right">
                <details class="text-left">
                  <summary class="inline-flex min-h-11 cursor-pointer items-center font-semibold text-brand underline-offset-4 hover:underline">Marcar como resuelta</summary>
                  <form method="post" class="mt-2 space-y-2" data-confirm="¿Marcar esta orden como resuelta? El proceso diario dejará de registrarla aunque PayPal confirme el cobro.">
                    <input type="hidden" name="intent" value="resolve_capture" />
                    <input type="hidden" name="order_id" value={capture.paypal_order_id} />
                    <label class="sr-only" for={`note-${capture.paypal_order_id}`}>Qué has comprobado</label>
                    <input id={`note-${capture.paypal_order_id}`} name="note" class={inputClass} placeholder="Por ejemplo: apuntada a mano / no hubo cobro" minlength="3" maxlength="200" required />
                    <button type="submit" class={`${secondaryButtonClass} px-4!`}>Marcar como resuelta</button>
                  </form>
                </details>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  )}

  <div class={cardClass}>
    {centers.length === 0 ? (
      <p class="text-base text-muted">Todavía no hay centros. Crea el primero con el formulario de más abajo.</p>
    ) : (
      <table class={tableClass}>
        <thead>
          <tr>
            <th class={thClass}>Centro</th>
            <th class={thClass}>Su web</th>
            <th class={thClass}>PayPal</th>
            <th class={thClass}>Estado</th>
            <th class={thClass}><span class="sr-only">Acciones</span></th>
          </tr>
        </thead>
        <tbody>
          {centers.map((center) => (
            <tr>
              <td class={`${tdClass} font-semibold text-ink`} data-label="Centro">{center.name}</td>
              <td class={tdClass} data-label="Su web">
                <a href={`/${center.slug}`} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-1 font-semibold text-brand hover:underline">
                  /{center.slug}
                  <Icon name="arrow-up-right" class="h-4 w-4" />
                  <span class="sr-only">(se abre en una pestaña nueva)</span>
                </a>
              </td>
              <td class={tdClass} data-label="PayPal">
                <span class={center.paypal_configured ? (center.paypal_env === 'live' ? chipClass.ok : chipClass.info) : chipClass.warn}>
                  {center.paypal_configured ? center.paypal_env === 'live' ? 'Cobra dinero real' : 'Solo pruebas' : 'Sin configurar'}
                </span>
              </td>
              <td class={tdClass} data-label="Estado">
                <span class={center.status === 'active' ? chipClass.ok : chipClass.muted}>{center.status === 'active' ? 'Visible' : 'Desactivado'}</span>
              </td>
              <td class="py-2">
                <div class="flex flex-wrap justify-end gap-2">
                  <a href={`/${center.slug}/admin`} class={`${secondaryButtonClass} px-4!`}>Abrir panel<span class="sr-only"> de {center.name}</span></a>
                  <a href={`/admin/centers/${center.slug}`} class={`${secondaryButtonClass} px-4!`}>Ajustes<span class="sr-only"> de {center.name}</span></a>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>

  <form method="post" class={`${cardClass} space-y-5`}>
    <h2 class="text-xl font-bold text-ink">Dar de alta un centro nuevo</h2>
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label class={labelClass} for="name">Nombre del centro</label>
        <input id="name" name="name" class={inputClass} maxlength="80" required />
      </div>
      <div>
        <label class={labelClass} for="slug">Dirección de su web</label>
        <input id="slug" name="slug" class={inputClass} maxlength="40" placeholder="nombre-del-centro" required />
        <p class={helpClass}>Su web será {host}/<strong>esto</strong>. Solo minúsculas, números y guiones. No se puede cambiar después.</p>
      </div>
    </div>
    <div class={formFooterClass}>
      <button type="submit" class={buttonClass}>Crear centro</button>
    </div>
  </form>

  {accountAudit.length > 0 && (
    <section class={`${cardClass} space-y-3`} data-testid="account-activity" aria-labelledby="account-activity-title">
      <h2 id="account-activity-title" class="text-xl font-bold text-ink">Actividad de cuentas</h2>
      <p class="text-base text-muted">Cambios que no pertenecen a un centro concreto, como cerrar la sesión en todos los dispositivos. Las 20 más recientes.</p>
      <table class={tableClass}>
        <thead>
          <tr>
            <th class={thClass}>Fecha</th>
            <th class={thClass}>Quién</th>
            <th class={thClass}>Qué</th>
          </tr>
        </thead>
        <tbody>
          {accountAudit.map((entry) => (
            <tr>
              <td class={`${tdClass} tabular`} data-label="Fecha">{formatDateTime(entry.created_at)}</td>
              <td class={tdClass} data-label="Quién">{entry.actor_email}</td>
              <td class={tdClass} data-label="Qué">{entry.summary}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  )}
</AdminLayout>
