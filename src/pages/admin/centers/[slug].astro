---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import Icon from "../../../components/Icon.astro";
import { buttonClass, cardClass, formFooterClass, helpClass, inputClass, labelClass, linkClass, secondaryButtonClass } from "../../../components/admin/ui";
import { parseEmail, parseFees, parsePaypal } from "../../../lib/admin/forms";
import { requiresNewSecret, savePaypalSettings } from "../../../lib/admin/paypal-settings";
import { guardSuperadmin } from "../../../lib/auth/guard";
import { centerNotFoundPage } from "../../../lib/error-pages";
import { getCenterBySlug, setCenterStatus, updateFeeSettings } from "../../../lib/repo/centers";
import { addCenterUser } from "../../../lib/repo/users";

const guard = await guardSuperadmin(Astro);
if (guard instanceof Response) return guard;
const { actor } = guard;

const center = await getCenterBySlug(Astro.params.slug ?? '');
if (!center) return centerNotFoundPage();

const here = `/admin/centers/${center.slug}`;
const percent = (rate: number) => String(Math.round(rate * 10000) / 100).replace('.', ',');
const fail = (message: string) => Astro.redirect(`${here}?error=${encodeURIComponent(message)}`, 303);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = form.get('intent');

  if (intent === 'paypal') {
    const parsed = parsePaypal(form);
    if (!parsed.ok) return fail(parsed.error);
    if (requiresNewSecret(center, parsed.value)) {
      return fail(center.paypal_configured
        ? 'Introduce el secret de PayPal al cambiar el Client ID o el entorno'
        : 'Introduce el secret de PayPal');
    }
    try {
      await savePaypalSettings(center.id, parsed.value, import.meta.env.ENCRYPTION_KEY);
    } catch (err) {
      console.error('PayPal settings save failed:', err instanceof Error ? err.message : 'unknown error');
      return fail('No se pudo guardar el secret; revisa la configuración de cifrado');
    }
  } else if (intent === 'fees') {
    const parsed = parseFees(form);
    if (!parsed.ok) return fail(parsed.error);
    await updateFeeSettings(center.id, parsed.value);
  } else if (intent === 'status') {
    const status = form.get('status');
    if (status !== 'active' && status !== 'disabled') return fail('Estado no válido');
    await setCenterStatus(center.id, status);
  } else if (intent === 'add_user') {
    const parsed = parseEmail(form.get('email'));
    if (!parsed.ok) return fail(parsed.error);
    await addCenterUser(center.id, parsed.value);
  } else {
    return fail('Acción no válida');
  }
  return Astro.redirect(`${here}?ok=1`, 303);
}
---

<AdminLayout title={`Ajustes de ${center.name}`} actor={actor} active="centers">
  <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
    <a href="/admin" class={`${linkClass} inline-flex min-h-11 items-center gap-1.5`}>
      <Icon name="arrow-left" class="h-4 w-4" />
      Todos los centros
    </a>
    <a href={`/${center.slug}/admin`} class={`${secondaryButtonClass} px-4!`}>Abrir su panel</a>
    <a href={`/${center.slug}/admin/users`} class={`${secondaryButtonClass} px-4!`}>Encargadas</a>
  </div>

  <form method="post" class={`${cardClass} space-y-5`}>
    <input type="hidden" name="intent" value="paypal" />
    <div>
      <h2 class="text-xl font-bold text-ink">PayPal</h2>
      <p class="mt-1 text-base text-muted">
        Con estos datos el centro recibe sus donaciones. Se copian de la aplicación del centro en developer.paypal.com.
        Ahora mismo: <strong>{center.paypal_configured ? `configurado (${center.paypal_env === 'live' ? 'dinero real' : 'pruebas'})` : 'sin configurar'}</strong>.
      </p>
    </div>
    <div>
      <label class={labelClass} for="client_id">Client ID</label>
      <input id="client_id" name="client_id" class={inputClass} value={center.paypal_client_id ?? ''} autocomplete="off" required />
    </div>
    <div>
      <label class={labelClass} for="secret">Secret</label>
      <input id="secret" name="secret" type="password" class={inputClass} autocomplete="new-password" />
      <p class={helpClass}>Nunca se muestra. Déjalo en blanco para conservar el actual; es obligatorio si cambias el Client ID o el entorno.</p>
    </div>
    <div>
      <label class={labelClass} for="env">Entorno</label>
      <select id="env" name="env" class={inputClass}>
        <option value="sandbox" selected={center.paypal_env === 'sandbox'}>Pruebas (sandbox): no se cobra dinero real</option>
        <option value="live" selected={center.paypal_env === 'live'}>Real (live): cobra dinero de verdad</option>
      </select>
    </div>
    <div class={formFooterClass}>
      <button type="submit" class={buttonClass}>Guardar PayPal</button>
    </div>
  </form>

  <form method="post" class={`${cardClass} space-y-5`}>
    <input type="hidden" name="intent" value="fees" />
    <div>
      <h2 class="text-xl font-bold text-ink">Comisiones de PayPal</h2>
      <p class="mt-1 text-base text-muted">
        Lo que PayPal cobra al centro en cada pago. Se usa para calcular cuánto se suma cuando el donante marca «Añadir las comisiones», de modo que el centro reciba la donación completa.
        Para ver la tarifa real, mira la columna «Tarifa» de las transacciones del centro en PayPal: tarifa dividida entre el importe, menos la cuota fija.
      </p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2">
      <fieldset class="space-y-4">
        <legend class="text-base font-bold text-ink">Botón de PayPal</legend>
        <div>
          <label class={labelClass} for="paypal_percent">Porcentaje (%)</label>
          <input id="paypal_percent" name="paypal_percent" class={inputClass} inputmode="decimal" value={percent(center.fees.paypal.rate)} required />
        </div>
        <div>
          <label class={labelClass} for="paypal_fixed">Cuota fija (€)</label>
          <input id="paypal_fixed" name="paypal_fixed" class={inputClass} inputmode="decimal" value={String(center.fees.paypal.fixed).replace('.', ',')} required />
        </div>
      </fieldset>
      <fieldset class="space-y-4">
        <legend class="text-base font-bold text-ink">Botón de tarjeta</legend>
        <div>
          <label class={labelClass} for="card_percent">Porcentaje (%)</label>
          <input id="card_percent" name="card_percent" class={inputClass} inputmode="decimal" value={percent(center.fees.card.rate)} required />
        </div>
        <div>
          <label class={labelClass} for="card_fixed">Cuota fija (€)</label>
          <input id="card_fixed" name="card_fixed" class={inputClass} inputmode="decimal" value={String(center.fees.card.fixed).replace('.', ',')} required />
        </div>
      </fieldset>
    </div>
    <p class={helpClass}>Un centro nuevo empieza con la tarifa estándar de PayPal, 2,9% + 0,35 €, en los dos botones. Es la opción segura: si la cuenta tiene una tarifa más baja, el donante paga unos céntimos de más, pero el centro nunca recibe menos. A Recoletos, por ejemplo, PayPal le cobra 1,2% + 0,35 € en tarjeta. Para entidades sin ánimo de lucro aprobadas por PayPal, la tarifa publicada es 1,9% + 0,35 €. Para dejarlo exacto, mira la columna «Tarifa» de las primeras transacciones del centro.</p>
    <div class={formFooterClass}>
      <button type="submit" class={buttonClass}>Guardar comisiones</button>
    </div>
  </form>

  <form method="post" class={`${cardClass} space-y-5`}>
    <input type="hidden" name="intent" value="status" />
    <div>
      <h2 class="text-xl font-bold text-ink">Visibilidad del centro</h2>
      <p class="mt-1 text-base text-muted">Un centro desactivado desaparece del listado, su web da error 404 y no admite donaciones nuevas.</p>
    </div>
    <div>
      <label class={labelClass} for="status">Estado</label>
      <select id="status" name="status" class={inputClass}>
        <option value="active" selected={center.status === 'active'}>Visible</option>
        <option value="disabled" selected={center.status === 'disabled'}>Desactivado</option>
      </select>
    </div>
    <div class={formFooterClass}>
      <button type="submit" class={buttonClass}>Guardar visibilidad</button>
    </div>
  </form>

  <form method="post" class={`${cardClass} space-y-5`}>
    <input type="hidden" name="intent" value="add_user" />
    <div>
      <h2 class="text-xl font-bold text-ink">Dar acceso a una encargada</h2>
      <p class="mt-1 text-base text-muted">Podrá entrar al panel de este centro con la cuenta de Google de ese correo.</p>
    </div>
    <div>
      <label class={labelClass} for="email">Correo de Google</label>
      <input id="email" name="email" type="email" class={inputClass} placeholder="nombre@gmail.com" required />
    </div>
    <div class={formFooterClass}>
      <button type="submit" class={buttonClass}>Dar acceso</button>
    </div>
  </form>
</AdminLayout>
