---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { buttonClass, cardClass, chipClass, dangerButtonClass, formFooterClass, helpClass, inputClass, labelClass, tableClass, tdClass, thClass } from "../../../components/admin/ui";
import { parseEmail, parseNotifySettings } from "../../../lib/admin/forms";
import { guardCenter } from "../../../lib/auth/guard";
import { updateNotifySettings } from "../../../lib/repo/centers";
import { addCenterUser, listCenterUsers, removeCenterUser } from "../../../lib/repo/users";

const guard = await guardCenter(Astro);
if (guard instanceof Response) return guard;
const { actor, center } = guard;
const here = `/${center.slug}/admin/users`;
const fail = (message: string) => Astro.redirect(`${here}?error=${encodeURIComponent(message)}`, 303);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (form.get('intent') === 'notify') {
    const settings = parseNotifySettings(form);
    if (!settings.ok) return fail(settings.error);
    await updateNotifySettings(center.id, settings.value);
    return Astro.redirect(`${here}?ok=notify-saved`, 303);
  }
  const parsed = parseEmail(form.get('email'));
  if (!parsed.ok) return fail(parsed.error);

  if (form.get('intent') === 'remove') {
    const outcome = await removeCenterUser(center.id, parsed.value, { force: actor.isSuperadmin });
    if (outcome === 'last') return fail('No se puede quitar a la última encargada del centro');
    if (outcome === 'missing') return fail('Ese correo no es encargada de este centro');
    if (!actor.isSuperadmin && parsed.value === actor.email.toLowerCase()) {
      return Astro.redirect(`/?left=${encodeURIComponent(center.slug)}`, 303);
    }
    return Astro.redirect(`${here}?ok=user-removed`, 303);
  }

  await addCenterUser(center.id, parsed.value);
  return Astro.redirect(`${here}?ok=user-added`, 303);
}

const users = await listCenterUsers(center.id);
const isSelf = (email: string) => !actor.isSuperadmin && email === actor.email.toLowerCase();
---

<AdminLayout
  title="Encargadas"
  intro="Las encargadas de este centro: las personas que pueden gestionar su web. Entran con su cuenta de Google."
  actor={actor}
  center={center}
  active="users"
>
  <div class={cardClass}>
    <h2 class="mb-2 text-xl font-bold text-ink">Personas con acceso</h2>
    <table class={tableClass}>
      <thead>
        <tr>
          <th class={thClass}>Correo</th>
          <th class={thClass}>Situación</th>
          <th class={thClass}><span class="sr-only">Acciones</span></th>
        </tr>
      </thead>
      <tbody>
        {users.map((user) => (
          <tr>
            <td class={`${tdClass} break-all font-semibold`} data-label="Correo">{user.email}</td>
            <td class={tdClass} data-label="Situación">
              <span class={user.firebase_uid ? chipClass.ok : chipClass.warn}>{user.firebase_uid ? 'Ya ha entrado' : 'Aún no ha entrado'}</span>
            </td>
            <td class="py-2 text-right">
              <form
                method="post"
                data-confirm={isSelf(user.email)
                  ? `Te quedarás sin acceso a ${center.name}. Para recuperarlo, otra encargada tendrá que darte acceso de nuevo. ¿Continuar?`
                  : '¿Quitar el acceso a esta persona?'}
              >
                <input type="hidden" name="intent" value="remove" />
                <input type="hidden" name="email" value={user.email} />
                <button type="submit" class={`${dangerButtonClass} px-4!`}>{isSelf(user.email) ? 'Dejar de ser encargada' : 'Quitar acceso'}</button>
              </form>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <form method="post" class={`${cardClass} space-y-5`}>
    <div>
      <h2 class="text-xl font-bold text-ink">Dar acceso a otra encargada</h2>
      <p class="mt-1 text-base text-muted">Podrá entrar al panel de este centro con la cuenta de Google de ese correo.</p>
    </div>
    <div>
      <label class={labelClass} for="email">Correo de Google</label>
      <input id="email" name="email" type="email" class={inputClass} placeholder="nombre@gmail.com" required />
      <p class={helpClass}>Tiene que ser el correo con el que esa persona entra a Google.</p>
    </div>
    <div class={formFooterClass}>
      <button type="submit" class={buttonClass}>Dar acceso</button>
    </div>
  </form>

  <form method="post" class={`${cardClass} space-y-5`}>
    <input type="hidden" name="intent" value="notify" />
    <div>
      <h2 class="text-xl font-bold text-ink">Avisos por correo</h2>
      <p class="mt-1 text-base text-muted">Cuando alguien dona por PayPal, avisamos por correo a las personas de la lista de arriba.</p>
    </div>
    <fieldset class="space-y-3">
      <legend class="sr-only">Cuándo avisar</legend>
      <label class="flex items-start gap-3 text-base text-ink">
        <input type="radio" name="notify_mode" value="each" checked={center.notify_mode !== 'none'} class="mt-1.5" />
        <span>Avisarme con cada donación</span>
      </label>
      <label class="flex items-start gap-3 text-base text-ink">
        <input type="radio" name="notify_mode" value="none" checked={center.notify_mode === 'none'} class="mt-1.5" />
        <span>No avisar</span>
      </label>
    </fieldset>
    <p class={helpClass}>
      A quien dona le enviamos siempre un correo de agradecimiento con el correo que facilita PayPal. Ese correo no se guarda en ninguna parte.
    </p>
    <div class={formFooterClass}>
      <button type="submit" class={buttonClass}>Guardar avisos</button>
    </div>
  </form>
</AdminLayout>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((form) => {
    form.addEventListener('submit', (event) => {
      if (!confirm(form.dataset.confirm ?? '')) event.preventDefault();
    });
  });
</script>
