---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import ImageUpload from "../../../../components/admin/ImageUpload.astro";
import { buttonClass, cardClass, chipClass, dangerButtonClass, formFooterClass, helpClass, inputClass, labelClass, linkClass, secondaryButtonClass } from "../../../../components/admin/ui";
import Icon from "../../../../components/Icon.astro";
import { formatEuro } from "../../../../lib/format";
import { MAX_ITEM_IMAGES, addItemImage, listAdminItems, listItemImages, removeItemImage, setCoverImage } from "../../../../lib/repo/items";
import { positionOptions } from "../../../../lib/admin/positions";
import { parseImageUrl, parseItem } from "../../../../lib/admin/forms";
import { recordAudit } from "../../../../lib/repo/audit";
import { guardCenter } from "../../../../lib/auth/guard";
import { isUuid } from "../../../../lib/ids";
import { getAdminItem, removeOrArchiveItem, updateItem } from "../../../../lib/repo/items";

const guard = await guardCenter(Astro);
if (guard instanceof Response) return guard;
const { actor, center } = guard;
const listUrl = `/${center.slug}/admin/items`;
const audit = (action: string, summary: string, entityId?: string) =>
  recordAudit({ centerId: center.id, actorEmail: actor.email, action, entityType: 'item', entityId: entityId ?? id, summary });

const { id } = Astro.params;
if (!isUuid(id)) return new Response('Artículo no encontrado', { status: 404 });

const item = await getAdminItem(center.id, id);
if (!item) return new Response('Artículo no encontrado', { status: 404 });

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const here = `${listUrl}/${item.id}`;

  if (form.get('intent') === 'remove') {
    const outcome = await removeOrArchiveItem(center.id, item.id);
    if (outcome !== 'missing') await audit(outcome === 'deleted' ? 'item.delete' : 'item.archive', `${outcome === 'deleted' ? 'Artículo borrado' : 'Artículo archivado'}: ${item.name}`);
    const message = outcome === 'archived' ? 'El artículo tiene donaciones que impiden borrarlo, se ha archivado' : '';
    return Astro.redirect(message ? `${listUrl}?error=${encodeURIComponent(message)}` : `${listUrl}?ok=item-removed`, 303);
  }

  const imageId = String(form.get('image_id') ?? '');
  const imageFailure = (message: string) => Astro.redirect(`${here}?error=${encodeURIComponent(message)}`, 303);

  if (form.get('intent') === 'add_image') {
    const image = parseImageUrl(form, center.slug);
    if (!image.ok) return imageFailure(image.error);
    const outcome = await addItemImage(center.id, item.id, image.value);
    if (outcome === 'full') return imageFailure(`Ya hay ${MAX_ITEM_IMAGES} imágenes. Quita alguna para poder añadir otra`);
    await audit('item.image_add', `Imagen añadida a ${item.name}`);
    return Astro.redirect(`${here}?ok=image-added`, 303);
  }
  if (form.get('intent') === 'remove_image') {
    if (!isUuid(imageId) || !(await removeItemImage(center.id, item.id, imageId))) return imageFailure('No se pudo quitar la imagen');
    await audit('item.image_remove', `Imagen quitada de ${item.name}`);
    return Astro.redirect(`${here}?ok=image-removed`, 303);
  }
  if (form.get('intent') === 'make_cover') {
    if (!isUuid(imageId) || !(await setCoverImage(center.id, item.id, imageId))) return imageFailure('No se pudo cambiar la portada');
    await audit('item.image_cover', `Portada cambiada en ${item.name}`);
    return Astro.redirect(`${here}?ok=cover-changed`, 303);
  }

  const parsed = parseItem(form, center.slug);
  if (!parsed.ok) return Astro.redirect(`${here}?error=${encodeURIComponent(parsed.error)}`, 303);
  await updateItem(center.id, item.id, parsed.value);
  await audit('item.update', `Artículo guardado: ${parsed.value.name}`);
  return Astro.redirect(`${here}?ok=item-saved`, 303);
}

const [images, allItems] = await Promise.all([listItemImages(center.id, item.id), listAdminItems(center.id)]);
const positions = positionOptions(allItems, item.id);
---

<AdminLayout title={item.name} actor={actor} center={center} active="items">
  <div class="space-y-1">
    <a href={listUrl} class={`${linkClass} inline-flex min-h-11 items-center gap-1.5`}>
      <Icon name="arrow-left" class="h-4 w-4" />
      Volver a los artículos
    </a>
    <p class="tabular text-base text-muted">
      Recaudado {formatEuro(item.raised)} de {formatEuro(item.goal)} · {item.donationCount} {item.donationCount === 1 ? 'donación' : 'donaciones'}
    </p>
  </div>

  {item.status === 'archived' && (
    <div role="status" class="flex items-start gap-3 rounded-lg bg-amber-50 px-4 py-3 text-base text-amber-900 ring-1 ring-amber-200">
      <Icon name="warning-circle" class="mt-0.5 h-5 w-5 shrink-0" />
      <p>
        Este artículo está archivado y no se ve en tu web. Para volver a mostrarlo, elige «Visible en la web» y guarda.
      </p>
    </div>
  )}

  <form method="post" class={`${cardClass} space-y-5`}>
    <div>
      <label class={labelClass} for="name">Nombre del artículo</label>
      <input id="name" name="name" class={inputClass} value={item.name} maxlength="120" required />
    </div>
    <div>
      <label class={labelClass} for="description">Descripción</label>
      <textarea id="description" name="description" class={inputClass} rows="4" maxlength="2000">{item.description}</textarea>
      <p class={helpClass}>Explica para qué sirve y por qué lo necesita el centro.</p>
    </div>
    <div class="grid gap-5 sm:grid-cols-3">
      <div>
        <label class={labelClass} for="goal">Precio del artículo (€)</label>
        <input id="goal" name="goal" class={inputClass} inputmode="decimal" value={item.goal.toFixed(2).replace('.', ',')} required />
        <p class={helpClass}>Lo que hay que reunir en total.</p>
      </div>
      <div>
        <label class={labelClass} for="status">Visibilidad</label>
        <select id="status" name="status" class={inputClass}>
          <option value="active" selected={item.status === 'active' || item.status === 'funded'}>Visible en la web</option>
          <option value="draft" selected={item.status === 'draft'}>Oculto (aún no se ve)</option>
          {item.status === 'archived' && <option value="archived" selected>Archivado (oculto)</option>}
        </select>
      </div>
      <div>
        <label class={labelClass} for="sort_order">Posición en la lista</label>
        <select id="sort_order" name="sort_order" class={inputClass}>
          {positions.map((option) => <option value={option.value} selected={option.selected}>{option.label}</option>)}
        </select>
        <p class={helpClass}>Si eliges una posición ocupada, los demás artículos se mueven solos para dejarle sitio.</p>
      </div>
    </div>
    <div class={formFooterClass}>
      <button type="submit" class={buttonClass}>Guardar cambios</button>
    </div>
  </form>

  <section class={`${cardClass} space-y-5`}>
    <div>
      <h2 class="text-xl font-bold text-ink">Imágenes del artículo</h2>
      <p class="mt-1 text-base text-muted">
        La primera es la portada: la que se ve en la lista. Las demás se ven al abrir el artículo. Puedes tener hasta {MAX_ITEM_IMAGES}. Los cambios de imágenes se guardan al momento, sin pulsar «Guardar cambios».
      </p>
    </div>
    {images.length === 0 ? (
      <p class="text-base text-muted">Este artículo todavía no tiene imágenes.</p>
    ) : (
      <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {images.map((image, index) => (
          <li class="space-y-3 rounded-lg border border-line p-3">
            <div class="aspect-video overflow-hidden rounded-md bg-surface">
              <img src={image.image_url} alt="" class="h-full w-full object-cover" />
            </div>
            <div class="flex flex-wrap items-center gap-2">
              {index === 0 ? (
                <span class={chipClass.info}>Portada</span>
              ) : (
                <form method="post">
                  <input type="hidden" name="intent" value="make_cover" />
                  <input type="hidden" name="image_id" value={image.id} />
                  <button type="submit" class={`${secondaryButtonClass} px-4!`}>Poner de portada</button>
                </form>
              )}
              <form method="post" onsubmit="return confirm('¿Quitar esta imagen del artículo?')">
                <input type="hidden" name="intent" value="remove_image" />
                <input type="hidden" name="image_id" value={image.id} />
                <button type="submit" class={`${dangerButtonClass} px-4!`}>Quitar</button>
              </form>
            </div>
          </li>
        ))}
      </ul>
    )}
    {images.length < MAX_ITEM_IMAGES && (
      <form method="post" class="space-y-4 border-t border-line pt-5">
        <input type="hidden" name="intent" value="add_image" />
        <ImageUpload slug={center.slug} name="image_url" label="Añadir otra imagen" help="Elige la imagen y, cuando salga «Imagen lista», pulsa Añadir imagen." requireUpload />
        <button type="submit" class={buttonClass}>Añadir imagen</button>
      </form>
    )}
  </section>

  <form
    method="post"
    class={`${cardClass} flex flex-wrap items-center justify-between gap-4`}
    onsubmit={`return confirm('${item.blockingDonationCount > 0 ? '¿Archivar este artículo? Dejará de verse en tu web.' : '¿Borrar este artículo para siempre?'}')`}
  >
    <input type="hidden" name="intent" value="remove" />
    <div class="max-w-xl">
      <h2 class="text-lg font-bold text-ink">{item.blockingDonationCount > 0 ? 'Archivar este artículo' : 'Borrar este artículo'}</h2>
      <p class="mt-1 text-base text-muted">
        {item.blockingDonationCount > 0
          ? 'Este artículo tiene donaciones vigentes o de PayPal que impiden borrarlo: se archiva y deja de verse en tu web, y el registro de lo recaudado se conserva.'
          : item.donationCount > 0
            ? 'Este artículo solo tiene donaciones apuntadas a mano que ya están anuladas. Se borrará para siempre, junto con ese registro.'
            : 'Este artículo no tiene donaciones, así que se borrará para siempre.'}
      </p>
    </div>
    <button type="submit" class={dangerButtonClass}>{item.blockingDonationCount > 0 ? 'Archivar artículo' : 'Borrar artículo'}</button>
  </form>
</AdminLayout>
