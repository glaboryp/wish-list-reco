---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { buttonClass, cardClass, chipClass, dangerButtonClass, formFooterClass, helpClass, inputClass, labelClass, tableClass, tdClass, thClass } from "../../../components/admin/ui";
import { formatEuro } from "../../../lib/format";
import { parseManualDonation } from "../../../lib/admin/forms";
import { guardCenter } from "../../../lib/auth/guard";
import { isUuid } from "../../../lib/ids";
import { addManualDonation, listDonations, voidManualDonation } from "../../../lib/repo/donations";
import { listAdminItems } from "../../../lib/repo/items";

const guard = await guardCenter(Astro);
if (guard instanceof Response) return guard;
const { actor, center } = guard;
const here = `/${center.slug}/admin/donations`;
const fail = (message: string) => Astro.redirect(`${here}?error=${encodeURIComponent(message)}`, 303);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();

  if (form.get('intent') === 'void') {
    const donationId = String(form.get('donation_id') ?? '');
    if (!isUuid(donationId) || !(await voidManualDonation(center.id, donationId))) {
      return fail('No se pudo anular la donación');
    }
    return Astro.redirect(`${here}?ok=donation-voided`, 303);
  }

  const parsed = parseManualDonation(form);
  if (!parsed.ok) return fail(parsed.error);
  const created = await addManualDonation({ centerId: center.id, ...parsed.value });
  if (created.status === 'missing') return fail('El artículo no existe en este centro');
  if (created.status === 'too_much') {
    return fail(created.remaining > 0
      ? `Solo faltan ${formatEuro(created.remaining)} para completar este artículo. Apunta como máximo esa cantidad`
      : 'Este artículo ya tiene todo el dinero reunido, no se puede apuntar más');
  }
  return Astro.redirect(`${here}?ok=donation-added`, 303);
}

const [donations, items] = await Promise.all([listDonations(center.id), listAdminItems(center.id)]);
const payable = items
  .filter((item) => item.status !== 'archived')
  .map((item) => ({ item, remaining: Math.round((item.goal - item.raised) * 100) / 100 }))
  .filter(({ remaining }) => remaining > 0);
const date = new Intl.DateTimeFormat('es-ES', { dateStyle: 'short', timeStyle: 'short' });
---

<AdminLayout
  title="Donaciones"
  intro="Todo lo que ha recibido tu centro. Las de PayPal se apuntan solas; las que llegan de otra forma (efectivo, transferencia...) las añades tú aquí."
  actor={actor}
  center={center}
  active="donations"
>
  <form method="post" class={`${cardClass} space-y-5`}>
    <div>
      <h2 class="text-xl font-bold text-ink">Añadir una donación recibida fuera de la web</h2>
      <p class="mt-1 text-base text-muted">Se suma al total del artículo que elijas, igual que una donación de PayPal.</p>
    </div>
    {payable.length === 0 ? (
      <p class="rounded-lg bg-surface px-4 py-3 text-base text-muted">
        Ahora mismo no hay ningún artículo al que apuntar dinero: todos tienen ya lo que necesitan o no hay artículos.
      </p>
    ) : (
      <>
        <div class="grid gap-5 sm:grid-cols-3">
          <div>
            <label class={labelClass} for="item_id">Artículo al que se destina</label>
            <select id="item_id" name="item_id" class={inputClass} required>
              {payable.map(({ item, remaining }) => (
                <option value={item.id} data-remaining={remaining}>{item.name} (faltan {formatEuro(remaining)})</option>
              ))}
            </select>
          </div>
          <div>
            <label class={labelClass} for="amount">Importe (€)</label>
            <input id="amount" name="amount" class={inputClass} inputmode="decimal" required aria-describedby="amount-hint" />
            <p class={helpClass} id="amount-hint">
              Máximo: <strong data-max-label></strong>, lo que falta por reunir de este artículo.
              <button type="button" data-fill-max class="ml-1 font-semibold text-brand underline-offset-4 hover:underline">Poner todo lo que falta</button>
            </p>
          </div>
          <div>
            <label class={labelClass} for="note">Nota (opcional)</label>
            <input id="note" name="note" class={inputClass} maxlength="200" />
            <p class={helpClass}>Por ejemplo: «efectivo» o «bizum».</p>
          </div>
        </div>
        <div class={formFooterClass}>
          <button type="submit" class={buttonClass}>Añadir donación</button>
        </div>
      </>
    )}
  </form>

  <div class={cardClass}>
    <h2 class="mb-2 text-xl font-bold text-ink">Donaciones recibidas</h2>
    {donations.length === 0 ? (
      <p class="text-base text-muted">Todavía no hay donaciones. Cuando alguien done, aparecerá aquí.</p>
    ) : (
      <table class={tableClass}>
        <thead>
          <tr>
            <th class={thClass}>Fecha</th>
            <th class={thClass}>Artículo</th>
            <th class={thClass}>Importe</th>
            <th class={thClass}>Cómo llegó</th>
            <th class={thClass}>Nota</th>
            <th class={thClass}><span class="sr-only">Acciones</span></th>
          </tr>
        </thead>
        <tbody>
          {donations.map((donation) => (
            <tr class={donation.voided_at ? 'text-muted' : ''}>
              <td class={`${tdClass} tabular`} data-label="Fecha">{date.format(new Date(donation.created_at))}</td>
              <td class={`${tdClass} font-semibold`} data-label="Artículo">{donation.item_name}</td>
              <td class={`${tdClass} tabular ${donation.voided_at ? 'line-through' : ''}`} data-label="Importe">
                {formatEuro(Number(donation.amount))}
              </td>
              <td class={tdClass} data-label="Cómo llegó">
                {donation.voided_at
                  ? <span class={chipClass.muted}>Anulada</span>
                  : <span class={donation.source === 'paypal' ? chipClass.info : chipClass.muted}>{donation.source === 'paypal' ? 'PayPal' : 'Apuntada a mano'}</span>}
              </td>
              <td class={tdClass} data-label="Nota">{donation.note ?? ''}</td>
              <td class="py-2 text-right">
                {donation.source === 'manual' && !donation.voided_at && (
                  <form method="post" onsubmit="return confirm('¿Anular esta donación? Dejará de sumar en el total del artículo.')">
                    <input type="hidden" name="intent" value="void" />
                    <input type="hidden" name="donation_id" value={donation.id} />
                    <button type="submit" class={`${dangerButtonClass} px-4!`}>Anular donación</button>
                  </form>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
  </div>
</AdminLayout>

<script>
  const select = document.getElementById('item_id') as HTMLSelectElement | null;
  const amount = document.getElementById('amount') as HTMLInputElement | null;
  const maxLabel = document.querySelector<HTMLElement>('[data-max-label]');
  const fillMax = document.querySelector<HTMLButtonElement>('[data-fill-max]');
  const euro = new Intl.NumberFormat('es-ES', { style: 'currency', currency: 'EUR' });

  if (select && amount && maxLabel && fillMax) {
    const remaining = () => Number(select.selectedOptions[0]?.dataset.remaining ?? 0);
    const refresh = () => {
      maxLabel.textContent = euro.format(remaining());
      validate();
    };
    const validate = () => {
      const value = Number(amount.value.replace(',', '.'));
      const tooMuch = amount.value.trim() !== '' && Number.isFinite(value) && value > remaining() + 0.001;
      amount.setCustomValidity(tooMuch ? `Como máximo ${euro.format(remaining())}, que es lo que falta por reunir` : '');
    };
    select.addEventListener('change', refresh);
    amount.addEventListener('input', validate);
    fillMax.addEventListener('click', () => {
      amount.value = remaining().toFixed(2).replace('.', ',');
      validate();
      amount.focus();
    });
    refresh();
  }
</script>
