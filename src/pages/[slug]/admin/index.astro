---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { cardClass, chipClass, linkClass, secondaryButtonClass, tableClass, tdClass, thClass } from "../../../components/admin/ui";
import { countItemsByStatus, itemsNearCompletion } from "../../../lib/dashboard";
import { formatDateTime, formatEuro } from "../../../lib/format";
import { guardCenter } from "../../../lib/auth/guard";
import { getDashboard } from "../../../lib/repo/donations";

const guard = await guardCenter(Astro);
if (guard instanceof Response) return guard;
const { actor, center } = guard;
const base = `/${center.slug}/admin`;

const { netRaised, donationCount, recent, items } = await getDashboard(center.id);
const counts = countItemsByStatus(items);
const nearCompletion = itemsNearCompletion(items);
const statusCards = [
  { label: 'Visibles', value: counts.visible },
  { label: 'Completados', value: counts.completed },
  { label: 'Ocultos', value: counts.hidden },
  { label: 'Archivados', value: counts.archived },
];
---

<AdminLayout
  title="Resumen"
  intro="Cómo va la campaña de tu centro de un vistazo."
  actor={actor}
  center={center}
  active="dashboard"
>
  <div class="grid gap-4 sm:grid-cols-2">
    <div class={cardClass} data-stat="raised">
      <p class="text-base font-semibold text-muted">Total recaudado</p>
      <p class="tabular mt-1 text-3xl font-bold text-ink">{formatEuro(netRaised)}</p>
      <p class="mt-1 text-sm text-muted">Sin contar las donaciones anuladas ni las comisiones.</p>
    </div>
    <div class={cardClass} data-stat="count">
      <p class="text-base font-semibold text-muted">Donaciones</p>
      <p class="tabular mt-1 text-3xl font-bold text-ink">{donationCount}</p>
      <p class="mt-1 text-sm"><a href={`${base}/donations`} class={linkClass}>Ver todas</a></p>
    </div>
  </div>

  <div class={cardClass} data-section="items-by-status">
    <h2 class="mb-4 text-xl font-bold text-ink">Artículos por estado</h2>
    <dl class="grid grid-cols-2 gap-4 sm:grid-cols-4">
      {statusCards.map((card) => (
        <div>
          <dt class="text-base text-muted">{card.label}</dt>
          <dd class="tabular text-2xl font-bold text-ink">{card.value}</dd>
        </div>
      ))}
    </dl>
  </div>

  <div class={cardClass} data-section="near-completion">
    <h2 class="mb-4 text-xl font-bold text-ink">Casi completos</h2>
    {nearCompletion.length === 0 ? (
      <p class="text-base text-muted">Ningún artículo ha llegado todavía al 75 % de lo que necesita.</p>
    ) : (
      <ul class="divide-y divide-line">
        {nearCompletion.map((item) => (
          <li class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 py-3">
            <a href={`${base}/items/${item.id}`} class={`${linkClass} text-base`}>{item.name}</a>
            <span class="tabular text-base text-muted">
              {formatEuro(item.raised)} de {formatEuro(item.goal)} <span class={chipClass.info}>{item.percent} %</span>
            </span>
          </li>
        ))}
      </ul>
    )}
  </div>

  <div class={cardClass} data-section="recent">
    <h2 class="mb-4 text-xl font-bold text-ink">Últimas donaciones</h2>
    {recent.length === 0 ? (
      <p class="text-base text-muted">Todavía no hay donaciones. Cuando alguien done, aparecerá aquí.</p>
    ) : (
      <table class={tableClass}>
        <thead>
          <tr>
            <th class={thClass}>Fecha</th>
            <th class={thClass}>Artículo</th>
            <th class={thClass}>Importe</th>
            <th class={thClass}>Cómo llegó</th>
          </tr>
        </thead>
        <tbody>
          {recent.map((donation) => (
            <tr class={donation.voided_at ? 'text-muted' : ''}>
              <td class={`${tdClass} tabular`} data-label="Fecha">{formatDateTime(donation.created_at)}</td>
              <td class={`${tdClass} font-semibold`} data-label="Artículo">{donation.item_name}</td>
              <td class={`${tdClass} tabular`} data-label="Importe">
                <span class={donation.voided_at ? 'line-through' : ''}>{formatEuro(Number(donation.amount))}</span>
              </td>
              <td class={tdClass} data-label="Cómo llegó">
                {donation.voided_at
                  ? <span class={chipClass.muted}>Anulada</span>
                  : <span class={donation.source === 'paypal' ? chipClass.info : chipClass.muted}>{donation.source === 'paypal' ? 'PayPal' : 'Apuntada a mano'}</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    )}
    <div class="mt-4">
      <a href={`${base}/donations`} class={secondaryButtonClass}>Ver todas las donaciones</a>
    </div>
  </div>
</AdminLayout>
