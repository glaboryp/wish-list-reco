---
import type { WishlistItem as Item } from "../types/database";
import { formatEuro } from "../lib/format";
import { fromCents, remainingCents } from "../lib/money";

const { item, slug, canDonate = false } = Astro.props as { item: Item; slug: string; canDonate?: boolean };
const progress = Math.min(100, Math.round((item.raised / item.goal) * 100));
const isFunded = item.status === 'funded';
const remaining = fromCents(remainingCents(item.goal, item.raised));
const href = `/${slug}/item/${item.id}`;
---

<article class="group relative flex h-full flex-col overflow-hidden rounded-xl border border-line bg-white shadow-card transition duration-200 hover:-translate-y-0.5 hover:shadow-lift">
  <div class="aspect-4/3 overflow-hidden bg-surface">
    {item.imageUrl ? (
      <img
        src={item.imageUrl}
        alt={item.imageAlt || item.name}
        loading="lazy"
        class:list={['h-full w-full object-cover transition-transform duration-300 group-hover:scale-105', isFunded && 'opacity-80']}
      />
    ) : (
      <div class="h-full w-full" style="background: color-mix(in srgb, var(--primary) 12%, white);"></div>
    )}
  </div>

  <div class="flex flex-1 flex-col gap-4 p-5">
    <div class="space-y-1.5">
      <h3 class="text-xl font-bold text-ink">
        <a href={href} class="after:absolute after:inset-0 after:content-[''] focus-visible:outline-none">{item.name}</a>
      </h3>
      {item.description && <p class="line-clamp-3 text-base text-muted" style="white-space: pre-line;">{item.description}</p>}
    </div>

    <div class="mt-auto space-y-3">
      <div>
        <div class="h-2 w-full overflow-hidden rounded-full bg-line" role="img" aria-label={`${progress}% reunido`}>
          <div class:list={['h-full rounded-full', isFunded && 'bg-green-800']} style={isFunded ? `width: ${progress}%;` : `width: ${progress}%; background-color: var(--primary);`}></div>
        </div>
        <p class="tabular mt-2 text-base text-ink">
          <strong class="font-bold">{formatEuro(item.raised)}</strong>
          <span class="text-muted"> de {formatEuro(item.goal)}</span>
        </p>
      </div>

      {isFunded ? (
        <p class="inline-flex items-center rounded-full bg-green-100 px-3 py-1 text-sm font-semibold text-green-900">
          Completado. ¡Gracias a todos!
        </p>
      ) : (
        <span
          data-cta
          class="inline-flex min-h-11 w-full items-center justify-center rounded-lg px-5 text-base font-semibold text-white transition-colors"
          style="background-color: var(--primary);"
        >
          {canDonate ? `Donar (faltan ${formatEuro(remaining)})` : 'Ver el artículo'}
        </span>
      )}
    </div>
  </div>
</article>

<style>
  article:hover [data-cta] {
    background-color: var(--primary-hover) !important;
  }

  article:has(a:focus-visible) {
    outline: 2px solid var(--primary);
    outline-offset: 3px;
  }
</style>
