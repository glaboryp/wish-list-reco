---
import Icon from "./Icon.astro";
import { DEFAULT_FEE_SCHEDULE, type FeeSchedule } from "../lib/fees";
import { paypalSdkUrl } from "../lib/paypal-sdk";

interface Props {
  itemId: string;
  itemName: string;
  slug: string;
  centerName?: string;
  maxDonation: number;
  paypalClientId: string;
  feeSchedule?: FeeSchedule;
}

const { itemId, itemName, slug, centerName = 'el centro', maxDonation, paypalClientId, feeSchedule = DEFAULT_FEE_SCHEDULE } = Astro.props;

const inputId = `amount-${itemId}`;
const buttonId = `paypal-button-${itemId}`;
const presets = [5, 10, 25, 50].filter((value) => value < maxDonation);
---

<div
  class="flex flex-col gap-4"
  id={`${buttonId}-form`}
  data-donation-form
  data-button-id={buttonId}
  data-input-id={inputId}
  data-item-id={itemId}
  data-slug={slug}
  data-max-donation={maxDonation}
  data-fee-schedule={JSON.stringify(feeSchedule)}
  data-sdk-url={paypalSdkUrl(paypalClientId)}
>
  <div>
    <label for={inputId} class="block text-base font-semibold text-ink">¿Cuánto quieres donar? (en euros)</label>
    <p id={`${inputId}-help`} class="mt-1 text-sm text-muted">
      Faltan {maxDonation} € para completar este artículo. Puedes donar desde 1 €.
    </p>
  </div>

  <div class="flex flex-wrap gap-2" data-presets>
    {presets.map((value) => (
      <button type="button" data-amount={value} class="min-h-11 rounded-lg border border-line-strong bg-white px-4 text-base font-semibold text-ink transition-colors hover:bg-surface aria-pressed:border-(color:--primary) aria-pressed:bg-surface" aria-pressed="false">
        {value} €
      </button>
    ))}
    <button type="button" data-amount={maxDonation} class="min-h-11 rounded-lg border border-line-strong bg-white px-4 text-base font-semibold text-ink transition-colors hover:bg-surface aria-pressed:border-(color:--primary) aria-pressed:bg-surface" aria-pressed="false">
      Completar ({maxDonation} €)
    </button>
  </div>

  <div>
    <input
      id={inputId}
      type="number"
      name="amount"
      min="1"
      max={maxDonation}
      step="1"
      inputmode="numeric"
      placeholder={`Otra cantidad, por ejemplo ${Math.min(10, maxDonation)}`}
      class="min-h-12 w-full rounded-lg border border-line-strong bg-white px-4 text-lg text-ink placeholder:text-muted focus:outline-none"
      style="--focus-color: var(--primary);"
      onfocus="this.style.borderColor='var(--primary)'; this.style.boxShadow='0 0 0 2px color-mix(in srgb, var(--primary) 25%, transparent)';"
      onblur="this.style.borderColor=''; this.style.boxShadow='';"
    />
    <p id={`${inputId}-error`} role="alert" class="mt-2 hidden text-sm font-semibold text-red-800">
      La cantidad no puede superar {maxDonation} €
    </p>
  </div>

  <div class="flex items-start gap-3">
    <input
      id={`${inputId}-cover-fees`}
      type="checkbox"
      class="mt-0.5 h-6 w-6 shrink-0 rounded border-line-strong"
      style="accent-color: var(--primary);"
    />
    <label for={`${inputId}-cover-fees`} class="text-base text-ink">
      Añadir las comisiones de PayPal para que {centerName} reciba la donación completa
      <span id={`${inputId}-fees-label-extra`} class="text-muted"></span>
    </label>
  </div>
  <p id={`${inputId}-fees-summary`} class="tabular hidden rounded-lg bg-surface px-3 py-2 text-base text-ink"></p>

  <div id={`${buttonId}-loading`} class="hidden py-2 text-center">
    <div class="inline-flex items-center gap-2 text-base font-semibold" style="color: var(--primary);">
      <svg class="h-5 w-5 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" aria-hidden="true">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span>Cargando el formulario de pago...</span>
    </div>
  </div>

  <p id={`${buttonId}-sdk-error`} role="alert" class="hidden rounded-lg bg-red-50 px-3 py-2 text-base font-semibold text-red-800">
    No hemos podido cargar PayPal. Revisa tu conexión y recarga la página para intentarlo de nuevo.
  </p>

  <div class="flex flex-col gap-2" id={`${buttonId}-buttons-container`}>
    <div id={`${buttonId}-paypal`} class="touch-manipulation paypal-buttons-container"></div>
    <div id={`${buttonId}-card`} class="touch-manipulation paypal-buttons-container"></div>
  </div>

  <p class="flex items-start gap-2 text-sm text-muted">
    <Icon name="lock-simple" class="mt-0.5 h-4 w-4 shrink-0" />
    <span>Pago seguro con PayPal o tarjeta. El dinero va directamente a {centerName}.</span>
  </p>
</div>

<div id={`${buttonId}-thanks`} class="hidden space-y-4" role="status">
  <h3 class="text-xl font-bold text-ink">¡Gracias por tu donación!</h3>
  <p class="text-base text-ink/90">Tu aportación a «{itemName}» ya cuenta y {centerName} te lo agradece de corazón.</p>
  <button type="button" data-reload class="inline-flex min-h-11 items-center justify-center rounded-lg px-5 text-base font-semibold text-white" style="background-color: var(--primary);">
    Ver el artículo actualizado
  </button>
</div>

<style>
  .paypal-buttons-container {
    position: relative;
    isolation: isolate;
    overflow: visible !important;
  }

  .paypal-buttons-container iframe {
    position: relative !important;
    display: block !important;
    pointer-events: auto !important;
  }

  .paypal-buttons-container iframe[name],
  .paypal-buttons-container iframe[id] {
    min-height: 500px !important;
    height: auto !important;
    max-height: none !important;
  }

  @media (max-width: 767px) {
    .paypal-buttons-container iframe[name],
    .paypal-buttons-container iframe[id] {
      min-height: 700px !important;
    }
  }

  /*
   * The card form opens inside the button's own container and PayPal keeps
   * resetting its height, so on small screens we pin a minimum height with
   * !important once the card button is clicked (the script sets data-expanded).
   */
  .paypal-buttons-container[data-expanded] :global(.paypal-buttons) {
    min-height: 770px !important;
  }

  @media (max-width: 499px) {
    .paypal-buttons-container[data-expanded] :global(.paypal-buttons) {
      min-height: 820px !important;
    }
  }

  @media (max-width: 399px) {
    .paypal-buttons-container[data-expanded] :global(.paypal-buttons) {
      min-height: 870px !important;
    }
  }
</style>

<script>
  import { initDonationForm } from "../scripts/donation-form";

  document.querySelectorAll<HTMLElement>("[data-donation-form]").forEach((root) => {
    const { buttonId, inputId, itemId, slug, maxDonation, feeSchedule, sdkUrl } = root.dataset;
    initDonationForm({
      buttonId: buttonId!,
      inputId: inputId!,
      itemId: itemId!,
      slug: slug!,
      maxDonation: Number(maxDonation),
      feeSchedule: JSON.parse(feeSchedule!),
      sdkUrl: sdkUrl!,
    });
  });
</script>
