---
import PlatformPage from "../layouts/PlatformPage.astro";
import { buttonClass } from "./admin/ui";

interface Props {
  title: string;
  heading: string;
  message: string;
}

const { title, heading, message } = Astro.props;
---

<PlatformPage title={title} analytics={false} noindex>
  <main class="mx-auto flex min-h-dvh w-full max-w-md flex-col justify-center px-4 py-10">
    <div class="rounded-xl border border-line bg-white p-6 shadow-card sm:p-8">
      <h1 class="text-3xl font-bold tracking-tight text-ink">{heading}</h1>
      <p class="mt-3 text-base text-muted">{message}</p>
      <a href="/" class={`${buttonClass} mt-8`}>Volver a la portada</a>
    </div>
  </main>
</PlatformPage>
