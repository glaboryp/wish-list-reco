---
import arrowRight from "@phosphor-icons/core/assets/regular/arrow-right.svg?raw";
import arrowLeft from "@phosphor-icons/core/assets/regular/arrow-left.svg?raw";
import arrowUpRight from "@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw";
import signOut from "@phosphor-icons/core/assets/regular/sign-out.svg?raw";
import googleLogo from "@phosphor-icons/core/assets/regular/google-logo.svg?raw";
import warningCircle from "@phosphor-icons/core/assets/regular/warning-circle.svg?raw";
import checkCircle from "@phosphor-icons/core/assets/regular/check-circle.svg?raw";
import uploadSimple from "@phosphor-icons/core/assets/regular/upload-simple.svg?raw";
import imageSquare from "@phosphor-icons/core/assets/regular/image-square.svg?raw";
import x from "@phosphor-icons/core/assets/regular/x.svg?raw";
import lockSimple from "@phosphor-icons/core/assets/regular/lock-simple.svg?raw";
import trash from "@phosphor-icons/core/assets/regular/trash.svg?raw";
import storefront from "@phosphor-icons/core/assets/regular/storefront.svg?raw";
import caretLeft from "@phosphor-icons/core/assets/regular/caret-left.svg?raw";
import caretRight from "@phosphor-icons/core/assets/regular/caret-right.svg?raw";
import heart from "@phosphor-icons/core/assets/fill/heart-fill.svg?raw";

const icons = {
  'arrow-right': arrowRight,
  'arrow-left': arrowLeft,
  'arrow-up-right': arrowUpRight,
  'sign-out': signOut,
  'google-logo': googleLogo,
  'warning-circle': warningCircle,
  'check-circle': checkCircle,
  'upload-simple': uploadSimple,
  'image-square': imageSquare,
  x,
  storefront,
  'caret-left': caretLeft,
  'caret-right': caretRight,
  heart,
  trash,
  'lock-simple': lockSimple,
};

interface Props {
  name: keyof typeof icons;
  class?: string;
}

const { name, class: className = 'h-5 w-5' } = Astro.props;
const svg = icons[name].replace('<svg', `<svg class="${className}" aria-hidden="true" focusable="false"`);
---

<Fragment set:html={svg} />
