# Postgres connection URL. Production: Neon. Local development uses .env.development (Docker, see README)
POSTGRES_URL=

# Only for a local Neon HTTP proxy (dev). Never set it against Neon or in production
NEON_FETCH_ENDPOINT=

# Seed / reset scripts (pnpm db:seed, pnpm db:reset)
# Host(s) of the production database, comma separated: the scripts refuse to run against them
PRODUCTION_DB_HOST=
# Set to 1 only to seed a disposable remote database (e.g. a Neon branch)
ALLOW_REMOTE_DB_RESET=
# Optional: your PayPal sandbox app credentials for the seeded centers
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_SECRET=

# Vercel Blob token (image uploads)
BLOB_READ_WRITE_TOKEN=

# base64 of 32 random bytes: openssl rand -base64 32
ENCRYPTION_KEY=

# at least 32 chars: openssl rand -base64 48
SESSION_SECRET=

# The only superadmin (Google account email)
SUPERADMIN_EMAIL=

# Firebase web app config (Authentication > Google provider enabled)
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=